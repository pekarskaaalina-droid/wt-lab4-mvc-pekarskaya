@model wt_lab4_mvc_pekarskaya.Models.Student
@{
    ViewData["Title"] = "Удалить студента";
}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 rounded-4 border-danger">
                <div class="card-body p-4 text-center">
                    <h1 class="h3 mb-4 text-danger">Удалить студента?</h1>
                    <p class="mb-2">Вы уверены, что хотите удалить:</p>
                    <h5 class="mb-4">@Model.FullName (@Model.Group)?</h5>
                    <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                        <button type="submit" class="btn btn-danger px-4">Да, удалить</button>
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">Отмена</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>