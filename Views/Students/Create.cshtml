@model wt_lab4_mvc_pekarskaya.Models.Student

@{
    ViewData["Title"] = "Добавить студента";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4">
                    <h1 class="h3 mb-4">Добавить нового студента</h1>

                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label fw-semibold">ФИО</label>
                            <input asp-for="FullName" class="form-control" placeholder="Иванов Иван Иванович" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Group" class="form-label fw-semibold">Группа</label>
                            <input asp-for="Group" class="form-control" placeholder="УИР-2" />
                            <span asp-validation-for="Group" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="AverageGrade" class="form-label fw-semibold">Средний балл</label>
                            <input asp-for="AverageGrade" class="form-control" type="number" step="0.01" min="0" max="10" placeholder="9.50" />
                            <span asp-validation-for="AverageGrade" class="text-danger small"></span>
                        </div>

                        <div class="form-check mb-4">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" checked />
                            <label asp-for="IsActive" class="form-check-label">Активен (учится)</label>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary px-4">Сохранить</button>
                            <a asp-action="Index" class="btn btn-outline-secondary px-4">← Назад</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}ы