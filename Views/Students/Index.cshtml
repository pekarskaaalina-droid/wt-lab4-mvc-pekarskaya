@model List<wt_lab4_mvc_pekarskaya.Models.Student>

@{
    ViewData["Title"] = "Каталог студентов";
}

<div class="container py-5">
    <!-- Шапка с кнопками -->
    <div class="d-flex justify-content-between align-items-center mb-5 flex-wrap gap-3">
        <div>
            <h1 class="display-5 fw-bold mb-1">Каталог студентов</h1>
            <p class="text-muted mb-0">Список всех студентов портала</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Create" class="btn btn-success">
                + Добавить студента
            </a>
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                ← На главную
            </a>
        </div>
    </div>

    <!-- Сетка карточек -->
    @if (Model.Count == 0)
    {
        <div class="alert alert-info text-center py-4">
            <h4 class="mb-2">Список пуст</h4>
            <p class="mb-0">Пока нет ни одного студента.</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var student in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm border-0 rounded-4">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <span class="badge bg-light text-dark fs-6">#@student.Id</span>
                                @if (student.IsActive)
                                {
                                    <span class="badge bg-success">Активен</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Неактивен</span>
                                }
                            </div>

                            <h5 class="card-title fw-bold mb-2">@student.FullName</h5>

                            <p class="text-muted mb-1">
                                <strong>Группа:</strong> @student.Group
                            </p>
                            <p class="text-muted mb-0">
                                <strong>Средний балл:</strong>
                                <span class="fs-5 fw-semibold text-primary">@student.AverageGrade.ToString("F2")</span>
                            </p>
                        </div>

                       <div class="card-footer bg-transparent border-0 p-3 pt-0 d-flex gap-2">
    <a asp-action="Details" asp-route-id="@student.Id" class="btn btn-primary flex-grow-1">
        Подробнее →
    </a>
    <a asp-action="Delete" asp-route-id="@student.Id" class="btn btn-outline-danger">
        Удалить
    </a>
</div>
                    </div>
                </div>
            }
        </div>
    }
</div>